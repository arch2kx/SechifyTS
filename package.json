{
  "name": "SechifyTS",
  "version": "1.1.4",
  "description": "A Chrome/Firefox extension that makes every thumbnail on YouTube have art from the artist/animator BlueSechi.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "web-ext lint",
    "zip": "npm run build && web-ext build --overwrite-dest --artifacts-dir=web-ext-artifacts"
  },
  "web-ext": {
    "ignoreFiles": [
      "*.zip",
      "tsconfig.json",
      "src/**/*.ts",
      "node_modules"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chrome": "^0.1.43",
    "@types/firefox-webext-browser": "^143.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "web-ext": "^10.6.0"
  }
}
